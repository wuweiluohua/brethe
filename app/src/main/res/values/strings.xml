    <!-- 节奏名 -->
    <string name="pattern_478_name">4-7-8 放松</string>
    <string name="pattern_478_desc">通过延长呼气激活副交感神经，适合睡前与感到焦虑时使用。</string>
    <string name="pattern_426_name">4-2-6 平衡</string>
    <string name="pattern_426_desc">节奏柔和，不屏息太久，适合练习入门或工作间隙使用。</string>
    <string name="pattern_box_name">盒式 4-4-4-4</string>
    <string name="pattern_box_desc">四段相等的对称节奏，常用于专注、演讲前或军警减压训练。</string>

    <!-- 环境音名称 -->
    <string name="ambient_calm_name">宁静氛围（默认）</string>
    <string name="ambient_calm_desc">缓慢和弦与低频氛围，柔和无风格倾向。</string>
    <string name="ambient_rain_name">雨声</string>
    <string name="ambient_rain_desc">密集细雨伴稀疏雨滴，适合焦虑时的稳定陪伴。</string>
    <string name="ambient_birds_name">林间鸟鸣</string>
    <string name="ambient_birds_desc">清晨草地与断续鸟鸣，适合清晨或白天减压。</string>
    <string name="ambient_birds_long_name">林间鸟鸣（长版）</string>
    <string name="ambient_birds_long_desc">6 分多钟春日渐浓的连续鸟鸣，适合长时间沉浸。</string>
    <string name="ambient_ocean_name">海浪</string>
    <string name="ambient_ocean_desc">每 8 秒一次的浪涌循环，沉浸放松。</string>
    <string name="ambient_ocean_long_name">海浪（长版）</string>
    <string name="ambient_ocean_long_desc">5 分多钟海滩海浪，连续自然，适合深度放松。</string>
    <string name="ambient_stream_name">溪水</string>
    <string name="ambient_stream_desc">高频水流加上随机水花，清爽通透。</string>
    <string name="ambient_campfire_name">篝火</string>
    <string name="ambient_campfire_desc">低沉燃烧床 + 随机噼啪，适合睡前与冥想。</string>

